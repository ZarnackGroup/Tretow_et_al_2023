Cell[TextData[{
 "Note : \[Beta] = 1/RT  in units of mol/kcal  gives \[Beta] = 1.68\n         \
    Tamayo et al, Cell Reports 19, 150 (2017) suggests exp(-\[Beta] gb) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.2", 
    SuperscriptBox["x10", 
     RowBox[{"-", "6"}]]}], TraditionalForm]],ExpressionUUID->
  "e938dc01-c1dc-4a55-8e7a-9c92f70151b3"],
 ", i.e.  \[Beta] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "b"], TraditionalForm]],ExpressionUUID->
  "5616fd89-2a59-40d4-a0ee-469f22dd3c35"],
 "=15.4\n\[Rho]  is given in mol/liter.\[LineSeparator]\ngF: Folding energy\
\[LineSeparator]gbF: Binding energy to a folded quadruplex \
\[LineSeparator]gb: Binding energy, regular\[LineSeparator]gp: Penalty for a \
loop (cooperative energy)\[LineSeparator]m: Number of binding sites per \
quadruplex (m=4)\[LineSeparator]n: Number of binding domains on the protein \
(n=3)\[LineSeparator]\[LineSeparator]Reference: Unfolded RNA without bound \
protein\nstate: Vector {l1,l2,..lj} characterizing number of bonds for j \
bounded proteins "
}], "Text",
 CellChangeTimes->{{3.8860972519279203`*^9, 3.886097308712316*^9}, {
