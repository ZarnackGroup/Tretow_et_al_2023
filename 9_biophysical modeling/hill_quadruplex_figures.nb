          RowBox[{"Length", "[", "state", "]"}]}], "}"}]}], "]"}]}], " ", "//.",
      " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"j", " ", "\[Rule]", " ", 
        RowBox[{"Length", "[", "state", "]"}]}], ",", " ", 
       RowBox[{"l", " ", "\[Rule]", " ", 
        RowBox[{"loops", "[", "state", "]"}]}]}], "}"}]}]}], " ", ";"}], 
