         RowBox[{"Exp", "[", "\[Beta]gb", "]"}], "\[Rho]"}], ")"}], "^", 
       "j"}], " ", "*", 
      RowBox[{
       RowBox[{"m", "!"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"j", "!"}], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"m", "-", "j", "-", "l"}], ")"}], "!"}]}], ")"}]}], "*", 
      RowBox[{"Product", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"combifactor", "[", 
          RowBox[{"state", ",", "i"}], "]"}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"(", 
