Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Beta]", "=", "1.68"}], ";", " ", 
    RowBox[{"ktarget", "=", 
     RowBox[{"3.", "*", 
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"-", "6"}], ")"}]}]}]}], ";"}], "  ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"betagb", "[", 
      RowBox[{"k_", ",", "\[Beta]gF_", ",", " ", "\[Beta]gp_"}], "]"}], " ", 
     "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Beta]gF", "-", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"144", "*", 
          RowBox[{"k", "^", "2"}]}], "]"}], "+", 
        RowBox[{"2", " ", "\[Beta]gp"}]}], ")"}], "/", "4."}]}], " ", ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ggb", "[", 
      RowBox[{"\[Beta]gF_", ",", "\[Beta]gp_"}], "]"}], ":=", " ", 
     RowBox[{"\[Beta]gb", " ", "//.", " ", 
      RowBox[{"FindRoot", "[", 
