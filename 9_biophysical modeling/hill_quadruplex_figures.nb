Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Beta]", "=", "1.68"}], ";", " ", 
    RowBox[{"\[Rho]c", "=", 
     RowBox[{"3.", "*", 
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"-", "6"}], ")"}]}]}]}], ";", " ", 
    RowBox[{"ktarget", " ", "=", " ", "\[Rho]c"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"betagF", "[", 
      RowBox[{"u_", ",", "\[Beta]gb_", ",", " ", "\[Beta]gp_"}], "]"}], " ", 
     "=", " ", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"144", "*", 
        RowBox[{"\[Rho]c", "^", "2"}]}], "]"}], "+", 
